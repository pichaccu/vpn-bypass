<Window x:Class="VpnBypass.Tray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="vpn-bypass" Height="520" Width="560"
        WindowStartupLocation="CenterScreen"
        Background="{x:Static SystemColors.WindowBrush}"
        TextElement.Foreground="{x:Static SystemColors.WindowTextBrush}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock x:Name="StatusDot" Text="●" FontSize="16" Margin="0,0,6,0" VerticalAlignment="Center" />
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="PauseButton" Content="Szüneteltetés" Padding="10,4" Click="OnPauseClick" />
            <Button x:Name="BrowseButton" Content="Tallózás…" Padding="10,4" Margin="8,0,0,0" Click="OnBrowseClick" />
            <TextBlock x:Name="HintText" VerticalAlignment="Center" Margin="12,0,0,0" Opacity="0.7"
                       Text="Pipáld ki, ami NE a VPN-en menjen." />
        </StackPanel>

        <Border Grid.Row="2" BorderBrush="{x:Static SystemColors.ActiveBorderBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AppList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox Grid.Column="0" Content="{Binding Name}"
                                          IsChecked="{Binding Excluded, Mode=TwoWay}"
                                          Checked="OnToggle" Unchecked="OnToggle" />
                                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Opacity="0.7"
                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3" x:Name="FooterText" Margin="0,8,0,0" Opacity="0.6" FontSize="11"
                   Text="dry-run: a terelés egyelőre csak naplózva (a végleges driver-modul beillesztése után lesz éles)." />
    </Grid>
</Window>
